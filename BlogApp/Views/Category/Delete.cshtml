@model Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="content-wrapper">
    <h2>Are you sure you want to delete "@Model.Name"?</h2>
    <hr />
    <p><strong>Description:</strong> @Model.Description</p>

    <form asp-action="DeleteConfirm" method="post">
        <input asp-for="Id" hidden />
        <button type="submit" class="btn btn-danger mt-2">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
    </form>
</div>